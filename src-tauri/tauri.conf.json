{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Memo",
  "version": "../package.json",
  "identifier": "com.memo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memo",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "quick",
        "title": "Memo - nova tarefa",
        "width": 640,
        "height": 132,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "notes",
        "title": "Memo - rascunho",
        "width": 360,
        "height": 420,
        "minWidth": 260,
        "minHeight": 180,
        "center": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sonka Software",
    "copyright": "© 2026 Sonka Software",
    "shortDescription": "Lembretes de tarefas do trabalho",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRDFFQkZFMTNFQTA5MUMKUldRY0Nlb1QvdXZSay81RDBvajBzd0x0L2paNUROWFlMaitzNkJOTGx2QVlYc0tIVTNwNktiQjEK",
      "endpoints": ["https://github.com/prxtenses/memo-reminders/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
